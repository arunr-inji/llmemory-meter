# ===========================================
# LLMemoryMeter Environment Variables
# ===========================================
# Copy this file to .env and uncomment/fill in your API keys

# -------------------------------------------
# Memory Tool API Keys
# -------------------------------------------
# Required for respective tools - only set the ones you plan to use

# Mem0 (requires both MEM0_API_KEY and OPENAI_API_KEY)
# MEM0_API_KEY=your_mem0_api_key_here

# OpenAI Memory (also used as underlying LLM for Mem0)
# OPENAI_API_KEY=your_openai_api_key_here

# Claude Memory
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini LLM provider for Mem0 (optional alternative to OpenAI)
# GOOGLE_API_KEY=your_google_api_key_here

# MemGPT/Letta Cloud
# MEMGPT_API_KEY=your_memgpt_api_key_here

# Zep Cloud
# ZEP_API_KEY=your_zep_api_key_here

# LangChain (future support)
# LANGCHAIN_API_KEY=your_langchain_api_key_here

# -------------------------------------------
# Performance Settings
# -------------------------------------------
# DEFAULT_TIMEOUT=30
# MAX_RETRIES=3
# DEBUG=false

# -------------------------------------------
# Configuration
# -------------------------------------------
# Default config file (uncomment to override)
# LLMEMORY_DEFAULT_CONFIG=configs/starter.yml
# LLMEMORY_DEFAULT_CONFIG=configs/comprehensive.yml

# -------------------------------------------
# Notifications (for run_overnight.sh)
# -------------------------------------------
# Telegram notifications - get token from @BotFather, chat_id from @userinfobot
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
