# API Keys for Memory Tools
MEM0_API_KEY=your_mem0_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Performance Settings
DEFAULT_TIMEOUT=30
MAX_RETRIES=3
DEBUG=false

# Optional: Default Configuration File
# LLMEMORY_DEFAULT_CONFIG=configs/comprehensive.yml  # Use comprehensive by default
# LLMEMORY_DEFAULT_CONFIG=configs/starter.yml       # Use starter by default (default)
